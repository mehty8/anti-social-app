<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical" >

        <TextView
            android:id="@+id/textViewLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Your session will expire within a minute,\n
please logout and login again"
            android:textAlignment="center"
            android:padding="10dp"/>

    <Button
        android:id="@+id/buttonLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:textColor="@color/sunsetDarkOrange"
        android:backgroundTint="@color/button_refresh_background_color"
        app:cornerRadius="20dp"
        app:strokeColor="@color/sunsetDarkOrange"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toBottomOf="@id/textViewLogout"
        android:layout_marginBottom="16dp"
        android:layout_gravity="center"/>
</LinearLayout>